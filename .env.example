# ReAdmin environment reference.
#
# `./install.sh` generates a real `.env` from this by asking for each value, so
# you normally never edit this file — copy it only if you want to fill things in
# by hand (`cp .env.example .env`).
#
# Every variable without an "optional" note is validated on boot by
# src/services/env.js, and next.config.js imports that validator, so a missing
# one fails the *build*, not just startup. See README §3 for the full reference.

# ── Runtime ───────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=production
# production | development | preview. Drives the Redis namespace and, when the
# self-hosting URLs below are unset, the API base URL and CORS allowlist.
# Keep this `production` on a self-hosted server: `development` restricts login
# to Founder/Developer/Tester accounts.
NEXT_PUBLIC_VERCEL_ENV=production
# `true` on any deployment that is not readmin.app. Unlocks workspace import.
SELF_HOSTED=true

# ── Self-hosting: your own hostnames ──────────────────────────────────────────
# Read at build time. Without these the panel calls https://api.readmin.app.
NEXT_PUBLIC_PANEL_URL=https://panel.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
# Comma-separated origins the API accepts cross-origin requests from — your
# panel URL, at minimum. Anything not listed is rejected by CORS.
CORS_ORIGINS=https://panel.example.com
# Space-separated extra hosts for the panel's Content-Security-Policy: your
# panel, API and CDN hosts, or the browser blocks your own assets.
# With STORAGE_DRIVER=local there is no CDN host to add — the API serves files.
CSP_EXTRA_DOMAINS=panel.example.com api.example.com

# ── Data stores ───────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@host/?tls=true
MONGODB_DATABASE=readmin
REDIS_URL=rediss://default:password@host:25061

# ── File storage ──────────────────────────────────────────────────────────────
# Where logos, banners, evidence, attachments and workspace exports are kept.
#   local  this server's own disk, served by the API. Nothing to sign up for.
#   s3     any S3-compatible bucket (DO Spaces, Cloudflare R2, MinIO, S3).
STORAGE_DRIVER=local

# --- STORAGE_DRIVER=local ---
# Must be writable by all three processes — panel, API and sync all serve tRPC
# and so all three accept uploads. Back it up: it is not reproducible.
STORAGE_LOCAL_PATH=/var/lib/readmin/storage
# Files are served from NEXT_PUBLIC_API_URL/files — private ones only through
# expiring signed links, so no extra host or CDN is involved.

# --- STORAGE_DRIVER=s3 (ignored entirely when the driver is local) ---
# CDN_ENDPOINT=https://nyc3.digitaloceanspaces.com
# CDN_REIGON=nyc3
# CDN_BUCKET_NAME=readmin-cdn
# CDN_ACCESS_KEY_ID=
# CDN_SECRET_ACCESS_KEY=
# Public base URL that serves the bucket.
# CDN_URL=https://cdn.example.com

# ── Secrets ───────────────────────────────────────────────────────────────────
# EXACTLY 32 bytes — used verbatim as an AES-256-CBC key. Changing it
# invalidates every stored OAuth token. `openssl rand -hex 16`
CRYPTO_KEY=
# Session JWT signing secret. `openssl rand -base64 48`
JSON_WEB_TOKEN_SECRET=

# ── Discord application ───────────────────────────────────────────────────────
DISCORD_CLIENT_ID=
# Same value; needed in the browser bundle at build time.
NEXT_PUBLIC_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_TOKEN=

# ── Roblox ────────────────────────────────────────────────────────────────────
ROBLOX_API_KEY=
ROBLOX_CLIENT_ID=
# Same value; used to build the authorize URL in the browser.
NEXT_PUBLIC_ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
# .ROBLOSECURITY cookie of the bot account.
ROBLOX_COOKIE=
ROBLOX_USER_ID=

# ── Bloxlink ──────────────────────────────────────────────────────────────────
BLOXLINK_TOKEN=

# ── Stripe (billing) ──────────────────────────────────────────────────────────
# Required by the schema. Self-hosted instances have no Premium to sell, so
# placeholders are fine — billing routes then fail if anyone reaches them.
STRIPE_PUBLIC=unused
STRIPE_SECRET=unused
STRIPE_SIGNING_SECRET=unused

# ── Required by the schema but never read (README §2.3) ──────────────────────
ROBLOX_SECRET=unused
AWS_ACCESS_KEY_ID=unused
AWS_SECRET_ACCESS_KEY=unused
CONTIGUITY_SECRET=unused

# ── Optional ──────────────────────────────────────────────────────────────────
# OpenSearch powers Roblox user search. Leave unset to disable it.
# OPENSEARCH_URL=
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=
# panel (default) or lambda; only tags the Mongo connection.
# APP_NAME=panel
# Set per process, not here — install.sh puts PORT in the systemd units so the
# panel and API can listen on different ports while sharing this file.
# PORT=
