[Unit]
Description=ReAdmin API (Fastify: tRPC + in-game REST)
Documentation=https://github.com/Jacksondude1223-bit/open-source-monorepo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__APP_DIR__
# `_moduleAliases` maps `~` to ./apiBuild at runtime, so this must start from
# the repo root. Environment= follows EnvironmentFile= so PORT wins over .env.
EnvironmentFile=__APP_DIR__/.env
# npm shells out to `node`, and systemd's default PATH may not include it.
Environment=PATH=__NODE_BIN_DIR__:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production
Environment=PORT=__API_PORT__
ExecStart=__NPM_BIN__ run fastify:start
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=readmin-api

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=__APP_DIR__

[Install]
WantedBy=multi-user.target
